# ════════════════════════════════════════════════════════════
#  GENERATED DOCS (scripts/generate-docs.js)
# ════════════════════════════════════════════════════════════
#
# "docs/" cannot be used here — git won't recurse into an ignored
# directory, so negations below it would silently do nothing.
# "docs/**" ignores contents while leaving the directory traversable,
# which allows the negations to work correctly.

docs/**

# Re-include the .vitepress/ directory so git traverses into it …
!docs/.vitepress/
# … then re-ignore its build/cache output inside it
docs/.vitepress/dist/
docs/.vitepress/cache/
docs/.vitepress/.temp/
# … and keep only the config source file
!docs/.vitepress/config.mjs

# Re-include static assets
!docs/public/
!docs/public/**

# Re-include hand-maintained root docs
!docs/index.md
!docs/README.md

.claude/settings.local.json